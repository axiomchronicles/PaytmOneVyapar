# ==============================================================================
# Paytm ONE Vyapar (Vyapaar Commander) — Master Environment Template
# ==============================================================================
# For complete backend configuration, see backend/.env.example
# For production VM deployment configuration, see deploy/docker-compose.prod.yml

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_CHECKPOINTER=memory

# ── Database & Cache ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vyapaar:change-me@localhost:5432/vyapaar
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_REQUIRED=false

# ── Authentication & Cryptography ─────────────────────────────────────────────
# IMPORTANT: Generate distinct random 32+ character secrets for each key
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_APPROVAL_SECRET=replace-with-a-distinct-32-random-character-secret
AUTH_OTP_SECRET=replace-with-a-third-distinct-32-random-character-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_APPROVAL_TOKEN_MINUTES=10
AUTH_OTP_EXPIRY_MINUTES=5
AUTH_OTP_RESEND_SECONDS=45
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_RESENDS=3

# ── OAuth Providers (Optional) ────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
APPLE_OAUTH_CLIENT_ID=

# ── LLM / Azure AI Foundry (Optional) ─────────────────────────────────────────
LLM_PROVIDER=disabled
LLM_MODEL=gpt-5.6-luna
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# ── Sarvam AI Realtime Voice Pipeline (Optional) ──────────────────────────────
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_CODEC=mp3
SARVAM_TTS_BITRATE=192k

# ── Telegram Bot Channel (Active Interactive Channel) ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=PaytmOneVyapar_bot

# ── Meta WhatsApp Cloud API (Preview / Coming Soon) ───────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0

# ── Transactional Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Paytm ONE Vyapar <auth@tuboxlabs.com>

# ── Vyapaar A2A Protocol v1 ───────────────────────────────────────────────────
A2A_AGENT_ID=11111111-1111-4111-8111-111111111111
A2A_SIGNING_SECRET=replace-with-a-separate-32-character-secret
A2A_MAX_CLOCK_SKEW_SECONDS=300

# ── Demand Forecasting ────────────────────────────────────────────────────────
FORECAST_MODEL=baseline
FORECAST_MODEL_PATH=models/demand.txt
FORECAST_MIN_TRAINING_ROWS=60

# ── Observability & Telemetry ─────────────────────────────────────────────────
TELEMETRY_ENABLED=false
TELEMETRY_OTLP_ENDPOINT=
SENTRY_DSN=
